{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_nuxt|_nitro|_dist|assets|favicon).*)",
      "destination": "/__nitro"
    }
  ],
  "functions": {
    "__nitro": {
      "runtime": "nodejs20.x",
      "handler": ".output/server/index.mjs"
    }
  }
}
